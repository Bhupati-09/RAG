# =====================================================================
# Knowledge IQ — Environment Configuration Template
# =====================================================================
# Copy this file to .env in your root directory before running the backend:
#   cp .env.example .env
#
# DO NOT commit .env or store real credentials or private keys here.
# =====================================================================

# ---------------------------------------------------------------------
# Backend Configuration (FastAPI)
# ---------------------------------------------------------------------

# Ollama local inference endpoint
OLLAMA_BASE_URL=http://localhost:11434

# LLM & Embedding models
LLM_MODEL=llama3.2
EMBED_MODEL=nomic-embed-text

# Ollama timeouts & context limits
OLLAMA_TIMEOUT=120.0
OLLAMA_KEEP_ALIVE=2m
OLLAMA_NUM_CTX=2048
OLLAMA_NUM_PREDICT=512

# RAG Chunking Parameters
# 512 tokens with 64 overlap provides balanced semantic cohesion for research papers and reports
RAG_CHUNK_SIZE=512
RAG_CHUNK_OVERLAP=64

# Retrieval default top-k passages
RAG_DEFAULT_TOP_K=4

# Allowed CORS origins (comma-separated list of exact browser origins)
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Local Storage Paths
UPLOAD_DIR=./data
CHROMA_DB_PATH=./chroma_db
METADATA_DB_PATH=./rag_metadata.sqlite3

# Upload Limits
MAX_UPLOAD_SIZE_MB=25
MAX_FILES_PER_UPLOAD=10

# ---------------------------------------------------------------------
# Frontend Configuration (Next.js - R/ or frontend/)
# ---------------------------------------------------------------------
# Set in R/.env.local or pass as environment variable to the frontend:
NEXT_PUBLIC_API_URL=http://localhost:8000
